{
  "schemaVersion": "1",
  "allowedProfiles": ["node-ts-agent", "python-agent"],
  "allowedModels": ["grok-4.6"],
  "maxDurationSeconds": 3600,
  "maxInferenceTokensPerJob": 2000000,
  "maxConcurrentAttemptsPerPrincipal": 4,
  "maxQueuedJobsPerPrincipal": 100,
  "retry": {
    "maxAttempts": 3,
    "backoffSeconds": 5
  },
  "leaseSeconds": 30,
  "requirements": {
    "processIsolation": "uid",
    "egress": "gateway-only"
  },
  "acknowledgedGaps": ["egress-not-enforced"],
  "maxReasoningEffort": "high",
  "builtinTools": ["files", "shell", "web", "agents"],
  "permissionModes": ["ask", "allow"]
}
