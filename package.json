{
  "name": "copilot-sdk-aspire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./contracts\" --filter \"./src/**\" run build",
    "typecheck": "pnpm -r --filter \"./contracts\" --filter \"./src/**\" run typecheck && tsc -p tsconfig.apphost.json --noEmit",
    "lint": "eslint apphost.mts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "aspire:run": "aspire run --apphost ./apphost.mts"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.0.0"
  }
}
