{
  "schemaVersion": "1",
  "id": "node-ts-agent",
  "displayName": "TypeScript Copilot SDK agent with Node.js and Python tools",
  "runnerProtocol": "1",
  "agent": {
    "language": "typescript",
    "sdk": "@github/copilot-sdk",
    "sdkVersion": "1.0.16",
    "firstParty": true
  },
  "entrypoint": {
    "command": "node",
    "args": ["dist/main.js"],
    "directory": "src/harness-hosting",
    "env": {
      "TOOLS_ROOT": "{root}/tools",
      "PYTHON_BIN": "python3"
    }
  },
  "toolchains": [
    { "name": "node", "version": "24" },
    { "name": "python", "version": "3.11" }
  ],
  "toolBindings": ["python:stats"],
  "capabilities": ["cancel", "structured-result", "prompt-sections", "model-options", "custom-agents", "skills", "builtin-tools", "interactive"]
}
