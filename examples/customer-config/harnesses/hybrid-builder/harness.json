{
  "schemaVersion": "1",
  "name": "hybrid-builder",
  "version": "1.0.0",
  "description": "An isolated worker that edits files and runs commands in its own container; every write or command waits for a person.",
  "interaction": "conversation",
  "instructionsFile": "instructions.md",
  "prompt": { "mode": "append" },
  "model": { "preferred": "grok-4.6", "allowed": ["grok-4.6"] },
  "tools": [],
  "builtinTools": ["files", "shell"],
  "permissions": {
    "default": "deny",
    "kinds": { "read": "allow", "write": "ask", "shell": "ask", "url": "deny" },
    "timeoutSeconds": 600
  },
  "input": { "schema": { "type": "object", "additionalProperties": false } },
  "output": { "schema": { "type": "object" } },
  "limits": { "maxDurationSeconds": 600, "maxInferenceTokens": 100000 },
  "retry": { "safeToRetry": false, "maxAttempts": 1 },
  "runners": { "allowedProfiles": ["node-ts-agent"], "defaultProfile": "node-ts-agent" }
}
