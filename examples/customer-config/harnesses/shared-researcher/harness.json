{
  "schemaVersion": "1",
  "name": "shared-researcher",
  "version": "1.0.0",
  "description": "A shared-runtime research assistant that reads public web pages, keeps notes in its workspace, and asks before writing or fetching.",
  "interaction": "conversation",
  "hosting": { "mode": "shared" },
  "instructionsFile": "instructions.md",
  "prompt": { "mode": "append" },
  "model": { "preferred": "grok-4.6", "allowed": ["grok-4.6"] },
  "tools": [],
  "builtinTools": ["files", "web"],
  "permissions": {
    "default": "deny",
    "kinds": { "read": "allow", "write": "ask", "url": "ask" },
    "questions": true,
    "approvalMode": "manual"
  },
  "input": { "schema": { "type": "object", "additionalProperties": false } },
  "output": { "schema": { "type": "object" } },
  "limits": { "maxDurationSeconds": 300, "maxInferenceTokens": 200000 },
  "retry": { "safeToRetry": false, "maxAttempts": 1 },
  "runners": { "allowedProfiles": ["node-ts-agent"], "defaultProfile": "node-ts-agent" }
}
