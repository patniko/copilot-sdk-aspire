{
  "schemaVersion": "1",
  "name": "hybrid-orchestrator",
  "version": "1.0.0",
  "description": "A shared-runtime coordinator that splits work across sized worker containers sharing one volume, and reports what they found.",
  "interaction": "conversation",
  "hosting": {
    "mode": "orchestrator",
    "workers": {
      "harnesses": ["hybrid-builder", "hybrid-reviewer"],
      "sizes": ["small", "medium"],
      "maxConcurrent": 2,
      "maxPerSession": 8,
      "sharedStorage": "session",
      "humanAuthority": "inherit",
      "crafting": { "template": "notes" }
    }
  },
  "instructionsFile": "instructions.md",
  "model": { "preferred": "grok-4.6", "allowed": ["grok-4.6"] },
  "tools": [],
  "permissions": {
    "default": "deny",
    "kinds": { "read": "allow", "write": "allow" }
  },
  "input": { "schema": { "type": "object", "additionalProperties": false } },
  "output": { "schema": { "type": "object" } },
  "limits": { "maxDurationSeconds": 300, "maxInferenceTokens": 500000 },
  "retry": { "safeToRetry": false, "maxAttempts": 1 },
  "runners": { "allowedProfiles": ["node-ts-agent"], "defaultProfile": "node-ts-agent" }
}
