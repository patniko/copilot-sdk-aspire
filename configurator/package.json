{
  "name": "@copilot-agent/configurator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local configurator: edit harnesses, policy, and deployment targets; build, run locally, and deploy.",
  "scripts": {
    "start": "vite build && tsx server/main.ts",
    "serve": "tsx server/main.ts",
    "dev": "tsx server/main.ts --dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@copilot-agent/contracts": "workspace:*",
    "@copilot-agent/service-defaults": "workspace:*",
    "fastify": "^5.4.0",
    "tsx": "^4.21.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@primer/octicons-react": "^19.38.0",
    "@primer/primitives": "^11.10.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.6.0",
    "clsx": "^2.1.1",
    "postcss": "^8.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "~3.4.17",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
